rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global safety net default-deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Boot health check document (contains no sensitive data)
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    // =========================================================================
    // Global Hardened Helpers
    // =========================================================================
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidLongId(id) {
      return id is string && id.size() >= 1 && id.size() <= 200 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEmailKey(emailKey) {
      return emailKey is string && emailKey.size() >= 3 && emailKey.size() <= 200
        && emailKey.matches('^[a-z0-9._%+\\-]+@[a-z0-9.\\-]+\\.[a-z]{2,}$');
    }

    function isValidSafeUrl(url) {
      return url is string && url.size() >= 1 && url.size() <= 500
        && (url.matches('^https?://[^\\s]+$') || url.matches('^/[^/].*$'));
    }

    function isValidAvatarUrl(url) {
      return url is string && url.size() >= 1 && url.size() <= 80000
        && (
          url.matches('^https?://[^\\s]+$')
          || url.matches('^/assets/[^\\s]+$')
          || url.matches('^data:image/(jpeg|jpg|png|webp);base64,[A-Za-z0-9+/=]+$')
        );
    }

    function isCallerEmailVerified() {
      return isSignedIn()
        && ('email' in request.auth.token)
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isCallerEmailVerified()
        && request.auth.token.email.lower() == 'kordelmauvesp@gmail.com';
    }

    function hasStaffPermissionDoc() {
      return isCallerEmailVerified()
        && exists(/databases/$(database)/documents/staff_permissions/$(request.auth.token.email.lower()));
    }

    function callerStaffPerm() {
      return get(/databases/$(database)/documents/staff_permissions/$(request.auth.token.email.lower())).data;
    }

    function isAdmin() {
      return isBootstrappedAdmin()
        || (hasStaffPermissionDoc() && callerStaffPerm().active == true && callerStaffPerm().canAdmin == true)
        || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function canAnnounce() {
      return isBootstrappedAdmin()
        || (hasStaffPermissionDoc() && callerStaffPerm().active == true && callerStaffPerm().canAnnounce == true);
    }

    function canViewReservedScreens() {
      return isBootstrappedAdmin()
        || (hasStaffPermissionDoc() && callerStaffPerm().active == true && (
          callerStaffPerm().canViewReserved == true
          || callerStaffPerm().canAdmin == true
          || callerStaffPerm().canAnnounce == true
        ));
    }

    function isUserNotDisabled(uid) {
      return !exists(/databases/$(database)/documents/users/$(uid))
        || get(/databases/$(database)/documents/users/$(uid)).data.disabled == false;
    }

    // =========================================================================
    // Validation Blueprints
    // =========================================================================
    function isValidAdminMarker(data, uid) {
      return data.keys().hasAll(['uid', 'email', 'grantedAt'])
        && data.keys().hasOnly(['uid', 'email', 'grantedAt'])
        && data.uid is string && data.uid == uid && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.grantedAt is timestamp;
    }

    function isValidUserProfile(data, uid) {
      return data.keys().hasAll([
          'uid', 'displayName', 'totalPoints', 'wins', 'gamesPlayed',
          'correctAnswers', 'totalAnswers', 'currentStreak', 'bestStreak',
          'tier', 'disabled', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'photoURL', 'totalPoints', 'wins', 'gamesPlayed',
          'correctAnswers', 'totalAnswers', 'currentStreak', 'bestStreak',
          'tier', 'disabled', 'lastActiveAt', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == uid && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 60
        && (!('photoURL' in data) || isValidAvatarUrl(data.photoURL))
        && data.totalPoints is int && data.totalPoints >= 0 && data.totalPoints <= 10000000
        && data.wins is int && data.wins >= 0 && data.wins <= 100000
        && data.gamesPlayed is int && data.gamesPlayed >= 0 && data.gamesPlayed <= 100000
        && data.correctAnswers is int && data.correctAnswers >= 0 && data.correctAnswers <= 1000000
        && data.totalAnswers is int && data.totalAnswers >= 0 && data.totalAnswers <= 1000000
        && data.currentStreak is int && data.currentStreak >= 0 && data.currentStreak <= 10000
        && data.bestStreak is int && data.bestStreak >= 0 && data.bestStreak <= 10000
        && data.tier in ['Aprendiz', 'Condutor', 'Especialista', 'Mestre da Estrada']
        && data.disabled is bool
        && (!('lastActiveAt' in data) || data.lastActiveAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, uid) {
      return data.keys().hasAll(['uid', 'email', 'voiceEnabled', 'notificationsEnabled', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'email', 'drivingSchool', 'province', 'voiceEnabled',
          'notificationsEnabled', 'broadcastsReadAtMs', 'notificationsClearedBeforeMs',
          'totpEnabled', 'totpSealedSecret', 'updatedAt'
        ])
        && data.uid is string && data.uid == uid && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && (!('drivingSchool' in data) || (data.drivingSchool is string && data.drivingSchool.size() <= 120))
        && (!('province' in data) || (data.province is string && data.province.size() <= 60))
        && data.voiceEnabled is bool
        && data.notificationsEnabled is bool
        && (!('broadcastsReadAtMs' in data) || (data.broadcastsReadAtMs is int && data.broadcastsReadAtMs >= 0))
        && (!('notificationsClearedBeforeMs' in data) || (data.notificationsClearedBeforeMs is int && data.notificationsClearedBeforeMs >= 0))
        && (!('totpEnabled' in data) || data.totpEnabled is bool)
        && (!('totpSealedSecret' in data) || (data.totpSealedSecret is string && data.totpSealedSecret.size() <= 1000))
        && data.updatedAt is timestamp;
    }

    function isValidPlatformUsersStats(data) {
      return data.keys().hasAll(['deletedCount', 'updatedAt'])
        && data.keys().hasOnly(['deletedCount', 'updatedAt'])
        && data.deletedCount is int && data.deletedCount >= 0 && data.deletedCount <= 100000000
        && data.updatedAt is timestamp;
    }

    function isValidRoom(data, roomId) {
      return data.keys().hasAll([
          'roomId', 'code', 'title', 'hostId', 'hostName', 'isPublic', 'status',
          'maxParticipants', 'participantCount', 'totalQuestions', 'timePerQuestion',
          'pointsPerCorrect', 'difficulty', 'category', 'currentQuestionIndex',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'roomId', 'code', 'title', 'description', 'hostId', 'hostName', 'isPublic', 'status',
          'maxParticipants', 'participantCount', 'finishedCount', 'totalQuestions', 'timePerQuestion',
          'pointsPerCorrect', 'difficulty', 'category', 'currentQuestionIndex',
          'questionStartedAtMs', 'questionEndsAtMs', 'questionEndsAt', 'roundToken',
          'aiSummary', 'createdAt', 'updatedAt'
        ])
        && data.roomId is string && data.roomId == roomId && isValidId(data.roomId)
        && data.code is string && data.code.size() >= 4 && data.code.size() <= 12 && data.code.matches('^[A-Z0-9]+$')
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 100
        && (!('description' in data) || (data.description is string && data.description.size() <= 300))
        && data.hostId is string && isValidId(data.hostId)
        && data.hostName is string && data.hostName.size() >= 2 && data.hostName.size() <= 60
        && data.isPublic is bool
        && data.status in ['WAITING', 'STARTING', 'PLAYING', 'ANSWER_REVEAL', 'LEADERBOARD', 'FINISHED']
        && data.maxParticipants is int && data.maxParticipants >= 2 && data.maxParticipants <= 1000
        && data.participantCount is int && data.participantCount >= 0 && data.participantCount <= data.maxParticipants
        && (!('finishedCount' in data) || (data.finishedCount is int && data.finishedCount >= 0 && data.finishedCount <= 100))
        && data.totalQuestions is int && data.totalQuestions >= 1 && data.totalQuestions <= 50
        && data.timePerQuestion is int && data.timePerQuestion >= 10 && data.timePerQuestion <= 180
        && data.pointsPerCorrect is int && data.pointsPerCorrect >= 1 && data.pointsPerCorrect <= 100
        && data.difficulty in ['Iniciante', 'Intermédio', 'Avançado', 'Exame Oficial']
        && data.category is string && data.category.size() >= 2 && data.category.size() <= 60
        && data.currentQuestionIndex is int && data.currentQuestionIndex >= -1 && data.currentQuestionIndex < data.totalQuestions
        && (!('questionStartedAtMs' in data) || (data.questionStartedAtMs is int && data.questionStartedAtMs >= 0))
        && (!('questionEndsAtMs' in data) || (data.questionEndsAtMs is int && data.questionEndsAtMs >= 0))
        && (!('questionEndsAt' in data) || (data.questionEndsAt is timestamp))
        && (!('roundToken' in data) || (data.roundToken is string && data.roundToken.size() <= 256))
        && (!('aiSummary' in data) || (data.aiSummary is string && data.aiSummary.size() <= 2000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidParticipant(data, roomId, uid) {
      return data.keys().hasAll([
          'uid', 'roomId', 'displayName', 'score', 'correctCount',
          'wrongCount', 'lastScoredQuestionIndex', 'status', 'currentQuestionIndex',
          'questionsGenerated', 'online', 'joinedAt', 'lastActiveAt'
        ])
        && data.keys().hasOnly([
          'uid', 'roomId', 'displayName', 'photoURL', 'score', 'correctCount',
          'wrongCount', 'lastScoredQuestionIndex', 'status', 'currentQuestionIndex',
          'questionsGenerated', 'questionStartedAtMs', 'questionEndsAtMs',
          'questionEndsAt', 'roundToken', 'finishedAt', 'online', 'joinedAt', 'lastActiveAt'
        ])
        && data.uid is string && data.uid == uid && isValidId(data.uid)
        && data.roomId is string && data.roomId == roomId && isValidId(data.roomId)
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 60
        && (!('photoURL' in data) || isValidAvatarUrl(data.photoURL))
        && data.score is int && data.score >= 0 && data.score <= 10000
        && data.correctCount is int && data.correctCount >= 0 && data.correctCount <= 100
        && data.wrongCount is int && data.wrongCount >= 0 && data.wrongCount <= 100
        && data.lastScoredQuestionIndex is int && data.lastScoredQuestionIndex >= -1 && data.lastScoredQuestionIndex <= 50
        && data.status in ['WAITING', 'PLAYING', 'ANSWER_REVEAL', 'FINISHED']
        && data.currentQuestionIndex is int && data.currentQuestionIndex >= -1 && data.currentQuestionIndex <= 50
        && data.questionsGenerated is bool
        && (!('questionStartedAtMs' in data) || (data.questionStartedAtMs is int && data.questionStartedAtMs >= 0))
        && (!('questionEndsAtMs' in data) || (data.questionEndsAtMs is int && data.questionEndsAtMs >= 0))
        && (!('questionEndsAt' in data) || (data.questionEndsAt is timestamp))
        && (!('roundToken' in data) || (data.roundToken is string && data.roundToken.size() <= 512))
        && (!('finishedAt' in data) || (data.finishedAt is timestamp))
        && data.online is bool
        && data.joinedAt is timestamp
        && data.lastActiveAt is timestamp;
    }

    function isValidRoomQuestion(data, roomId) {
      return data.keys().hasAll([
          'roomId', 'questionIndex', 'questionText', 'options', 'category',
          'difficulty', 'signType', 'sealedPayload', 'answerCommitment', 'createdAt'
        ])
        && data.keys().hasOnly([
          'roomId', 'uid', 'questionIndex', 'questionText', 'options', 'category',
          'difficulty', 'signType', 'sealedPayload', 'answerCommitment', 'createdAt'
        ])
        && data.roomId is string && data.roomId == roomId && isValidId(data.roomId)
        && (!('uid' in data) || (data.uid is string && isValidId(data.uid)))
        && data.questionIndex is int && data.questionIndex >= 0 && data.questionIndex < 50
        && data.questionText is string && data.questionText.size() >= 5 && data.questionText.size() <= 500
        && data.options is list && data.options.size() == 4
        && data.options[0] is string && data.options[1] is string
        && data.options[2] is string && data.options[3] is string
        && data.category is string && data.category.size() >= 2 && data.category.size() <= 80
        && data.difficulty is string && data.difficulty.size() >= 2 && data.difficulty.size() <= 40
        && data.signType is string && data.signType.size() >= 1 && data.signType.size() <= 60
        && data.sealedPayload is string && data.sealedPayload.size() >= 10 && data.sealedPayload.size() <= 4000
        && data.answerCommitment is string && data.answerCommitment.size() >= 16 && data.answerCommitment.size() <= 128
        && data.createdAt is timestamp;
    }

    function isValidRoomAnswer(data, roomId) {
      return data.keys().hasAll(['roomId', 'questionIndex', 'uid', 'displayName', 'selectedIndex', 'submittedAt'])
        && data.keys().hasOnly(['roomId', 'questionIndex', 'uid', 'displayName', 'selectedIndex', 'submittedAt'])
        && data.roomId is string && data.roomId == roomId && isValidId(data.roomId)
        && data.questionIndex is int && data.questionIndex >= 0 && data.questionIndex < 50
        && data.uid is string && data.uid == request.auth.uid && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 60
        && data.selectedIndex is int && data.selectedIndex >= 0 && data.selectedIndex <= 3
        && data.submittedAt is timestamp;
    }

    function isValidRevealedAnswer(data, roomId) {
      return data.keys().hasAll([
          'roomId', 'questionIndex', 'correctIndex', 'explanation',
          'legalReference', 'revealProof', 'revealedAt'
        ])
        && data.keys().hasOnly([
          'roomId', 'uid', 'questionIndex', 'correctIndex', 'explanation',
          'legalReference', 'revealProof', 'revealedAt'
        ])
        && data.roomId is string && data.roomId == roomId && isValidId(data.roomId)
        && (!('uid' in data) || (data.uid is string && isValidId(data.uid)))
        && data.questionIndex is int && data.questionIndex >= 0 && data.questionIndex < 50
        && data.correctIndex is int && data.correctIndex >= 0 && data.correctIndex <= 3
        && data.explanation is string && data.explanation.size() >= 5 && data.explanation.size() <= 1500
        && data.legalReference is string && data.legalReference.size() >= 2 && data.legalReference.size() <= 300
        && data.revealProof is string && data.revealProof.size() >= 16 && data.revealProof.size() <= 256
        && data.revealedAt is timestamp;
    }

    function isValidPlayerScoreStep(roomId, uid, inc, ex) {
      let room = get(/databases/$(database)/documents/rooms/$(roomId)).data;
      let qIdx = ex.currentQuestionIndex;
      let revealed = get(/databases/$(database)/documents/rooms/$(roomId)/player_revealed/$(uid + '_' + string(qIdx))).data;
      let ansPath = /databases/$(database)/documents/rooms/$(roomId)/answers/$(string(qIdx) + '_' + uid);
      let isCorrect = exists(ansPath) && get(ansPath).data.selectedIndex == revealed.correctIndex;
      return room.status != 'FINISHED'
        && (!('finishedCount' in room) || room.finishedCount < 100)
        && ex.status == 'PLAYING'
        && inc.status == 'ANSWER_REVEAL'
        && inc.currentQuestionIndex == qIdx
        && inc.lastScoredQuestionIndex == qIdx
        && ex.lastScoredQuestionIndex == qIdx - 1
        && (
          isCorrect
            ? (inc.score == ex.score + room.pointsPerCorrect && inc.correctCount == ex.correctCount + 1 && inc.wrongCount == ex.wrongCount)
            : (inc.score == ex.score && inc.correctCount == ex.correctCount && inc.wrongCount == ex.wrongCount + 1)
        );
    }

    function isValidCompetitionArchive(data, competitionId) {
      return data.keys().hasAll([
          'competitionId', 'roomId', 'title', 'code', 'winnerUid', 'winnerName',
          'winnerScore', 'participantCount', 'totalQuestions', 'isPublic', 'finishedAt'
        ])
        && data.keys().hasOnly([
          'competitionId', 'roomId', 'title', 'code', 'winnerUid', 'winnerName',
          'winnerScore', 'participantCount', 'totalQuestions', 'isPublic', 'finishedAt'
        ])
        && data.competitionId is string && data.competitionId == competitionId && isValidId(data.competitionId)
        && data.roomId is string && isValidId(data.roomId)
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 100
        && data.code is string && data.code.size() >= 4 && data.code.size() <= 12
        && data.winnerUid is string && data.winnerUid.size() <= 128
        && data.winnerName is string && data.winnerName.size() <= 60
        && data.winnerScore is int && data.winnerScore >= 0 && data.winnerScore <= 10000
        && data.participantCount is int && data.participantCount >= 0 && data.participantCount <= 1000
        && data.totalQuestions is int && data.totalQuestions >= 1 && data.totalQuestions <= 50
        && data.isPublic is bool
        && data.finishedAt is timestamp;
    }

    function isValidUserResult(data, resultId) {
      return data.keys().hasAll([
          'resultId', 'roomId', 'roomTitle', 'uid', 'displayName', 'score',
          'correctCount', 'wrongCount', 'accuracy', 'rank', 'totalParticipants',
          'totalQuestions', 'isWinner', 'isPublic', 'finishedAt'
        ])
        && data.keys().hasOnly([
          'resultId', 'roomId', 'roomTitle', 'uid', 'displayName', 'score',
          'correctCount', 'wrongCount', 'accuracy', 'rank', 'totalParticipants',
          'totalQuestions', 'isWinner', 'isPublic', 'finishedAt'
        ])
        && data.resultId is string && data.resultId == resultId && isValidLongId(data.resultId)
        && data.roomId is string && isValidId(data.roomId)
        && data.roomTitle is string && data.roomTitle.size() >= 3 && data.roomTitle.size() <= 100
        && data.uid is string && data.uid == request.auth.uid && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 60
        && data.score is int && data.score >= 0 && data.score <= 10000
        && data.correctCount is int && data.correctCount >= 0 && data.correctCount <= 100
        && data.wrongCount is int && data.wrongCount >= 0 && data.wrongCount <= 100
        && data.accuracy is int && data.accuracy >= 0 && data.accuracy <= 100
        && data.rank is int && data.rank >= 1 && data.rank <= 1000
        && data.totalParticipants is int && data.totalParticipants >= 1 && data.totalParticipants <= 1000
        && data.totalQuestions is int && data.totalQuestions >= 1 && data.totalQuestions <= 50
        && data.isWinner is bool
        && data.isPublic is bool
        && data.finishedAt is timestamp;
    }

    function isValidRankingEntry(data) {
      return data.keys().hasAll(['uid', 'displayName', 'points', 'wins', 'gamesPlayed', 'accuracy', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'points', 'wins', 'gamesPlayed', 'accuracy', 'weekKey', 'updatedAt'])
        && data.uid is string && data.uid == request.auth.uid && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 60
        && (!('photoURL' in data) || isValidAvatarUrl(data.photoURL))
        && data.points is int && data.points >= 0 && data.points <= 10000000
        && data.wins is int && data.wins >= 0 && data.wins <= 100000
        && data.gamesPlayed is int && data.gamesPlayed >= 0 && data.gamesPlayed <= 100000
        && data.accuracy is int && data.accuracy >= 0 && data.accuracy <= 100
        && (!('weekKey' in data) || (data.weekKey is string && data.weekKey.size() <= 20))
        && data.updatedAt is timestamp;
    }

    function isValidAchievement(data) {
      return data.keys().hasAll(['uid', 'achievementId', 'title', 'description', 'tier', 'unlockedAt'])
        && data.keys().hasOnly(['uid', 'achievementId', 'title', 'description', 'tier', 'unlockedAt'])
        && data.uid is string && data.uid == request.auth.uid && isValidId(data.uid)
        && data.achievementId is string && isValidId(data.achievementId)
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 80
        && data.description is string && data.description.size() >= 4 && data.description.size() <= 200
        && data.tier in ['bronze', 'silver', 'gold']
        && data.unlockedAt is timestamp;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['uid', 'title', 'body', 'read', 'createdAt'])
        && data.keys().hasOnly(['uid', 'title', 'body', 'roomId', 'linkUrl', 'linkLabel', 'kind', 'aiGenerated', 'read', 'createdAt'])
        && data.uid is string && isValidId(data.uid)
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 100
        && data.body is string && data.body.size() >= 2 && data.body.size() <= 300
        && (!('roomId' in data) || (data.roomId is string && data.roomId.size() <= 128))
        && (!('linkUrl' in data) || isValidSafeUrl(data.linkUrl))
        && (!('linkLabel' in data) || (data.linkLabel is string && data.linkLabel.size() <= 60))
        && (!('kind' in data) || data.kind in ['informative', 'link', 'ad_banner', 'ad_audio', 'ad_video'])
        && (!('aiGenerated' in data) || data.aiGenerated is bool)
        && data.read is bool
        && data.createdAt is timestamp;
    }

    function isValidBroadcast(data, broadcastId) {
      return data.keys().hasAll([
          'id', 'kind', 'title', 'body', 'aiGenerated', 'active',
          'showInBanner', 'durationSeconds', 'cooldownMinutes',
          'createdByUid', 'createdByEmail', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'kind', 'title', 'body', 'linkUrl', 'linkLabel', 'mediaUrl',
          'aiGenerated', 'active', 'showInBanner', 'durationSeconds', 'cooldownMinutes',
          'createdByUid', 'createdByEmail', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == broadcastId && isValidId(data.id)
        && data.kind in ['informative', 'link', 'ad_banner', 'ad_audio', 'ad_video']
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 120
        && data.body is string && data.body.size() >= 2 && data.body.size() <= 600
        && (!('linkUrl' in data) || isValidSafeUrl(data.linkUrl))
        && (!('linkLabel' in data) || (data.linkLabel is string && data.linkLabel.size() <= 60))
        && (!('mediaUrl' in data) || isValidSafeUrl(data.mediaUrl))
        && data.aiGenerated is bool
        && data.active is bool
        && data.showInBanner is bool
        && data.durationSeconds is int && data.durationSeconds >= 1
        && (
          (data.kind == 'ad_banner' && data.durationSeconds <= 8)
          || (data.kind == 'ad_video' && data.durationSeconds <= 20)
          || (data.kind in ['informative', 'link', 'ad_audio'] && data.durationSeconds <= 60)
        )
        && data.cooldownMinutes is int && data.cooldownMinutes >= 1 && data.cooldownMinutes <= 120
        && data.createdByUid is string && isValidId(data.createdByUid)
        && data.createdByEmail is string && data.createdByEmail.size() >= 3 && data.createdByEmail.size() <= 200
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidQuestionBankItem(data) {
      return data.keys().hasAll([
          'questionText', 'options', 'correctIndex', 'explanation', 'legalReference',
          'category', 'difficulty', 'signType', 'active', 'createdBy', 'createdAt'
        ])
        && data.keys().hasOnly([
          'questionText', 'options', 'correctIndex', 'explanation', 'legalReference',
          'category', 'difficulty', 'signType', 'active', 'createdBy', 'createdAt'
        ])
        && data.questionText is string && data.questionText.size() >= 5 && data.questionText.size() <= 500
        && data.options is list && data.options.size() == 4
        && data.options[0] is string && data.options[1] is string
        && data.options[2] is string && data.options[3] is string
        && data.correctIndex is int && data.correctIndex >= 0 && data.correctIndex <= 3
        && data.explanation is string && data.explanation.size() >= 5 && data.explanation.size() <= 1500
        && data.legalReference is string && data.legalReference.size() >= 2 && data.legalReference.size() <= 300
        && data.category is string && data.category.size() >= 2 && data.category.size() <= 80
        && data.difficulty is string && data.difficulty.size() >= 2 && data.difficulty.size() <= 40
        && data.signType is string && data.signType.size() >= 1 && data.signType.size() <= 60
        && data.active is bool
        && data.createdBy is string && data.createdBy == request.auth.uid
        && data.createdAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['actorUid', 'actorEmail', 'action', 'targetType', 'targetId', 'details', 'createdAt'])
        && data.keys().hasOnly(['actorUid', 'actorEmail', 'action', 'targetType', 'targetId', 'details', 'createdAt'])
        && data.actorUid is string && data.actorUid == request.auth.uid && isValidId(data.actorUid)
        && data.actorEmail is string && data.actorEmail.size() >= 3 && data.actorEmail.size() <= 200
        && data.action is string && data.action.size() >= 2 && data.action.size() <= 80
        && data.targetType is string && data.targetType.size() >= 2 && data.targetType.size() <= 60
        && data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128
        && data.details is string && data.details.size() >= 2 && data.details.size() <= 1000
        && data.createdAt is timestamp;
    }

    function isValidStaffPermission(data, emailKey) {
      return data.keys().hasAll([
          'email', 'canViewReserved', 'canAdmin', 'canAnnounce',
          'active', 'addedByUid', 'addedByEmail', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'email', 'label', 'canViewReserved', 'canAdmin', 'canAnnounce',
          'active', 'addedByUid', 'addedByEmail', 'createdAt', 'updatedAt'
        ])
        && data.email is string && data.email == emailKey && isValidEmailKey(data.email)
        && (!('label' in data) || (data.label is string && data.label.size() <= 60))
        && data.canViewReserved is bool
        && data.canAdmin is bool
        && data.canAnnounce is bool
        && data.active is bool
        && data.addedByUid is string && data.addedByUid == request.auth.uid && isValidId(data.addedByUid)
        && data.addedByEmail is string && data.addedByEmail.size() >= 3 && data.addedByEmail.size() <= 200
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // =========================================================================
    // LIVE CHAT Security Helpers & Validators
    // =========================================================================
    function isChatMember(chatId) {
      return isSignedIn() && isValidId(chatId)
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
    }

    function isChatAdmin(chatId) {
      return isSignedIn() && isValidId(chatId)
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.adminIds
          || get(/databases/$(database)/documents/chats/$(chatId)).data.createdBy == request.auth.uid
        );
    }

    function isBlockedByUser(targetUid, actorUid) {
      return exists(/databases/$(database)/documents/chat_presence/$(targetUid))
        && ('blockedUids' in get(/databases/$(database)/documents/chat_presence/$(targetUid)).data)
        && actorUid in get(/databases/$(database)/documents/chat_presence/$(targetUid)).data.blockedUids;
    }

    function isDirectChatBlocked(chatData, actorUid) {
      return chatData.type == 'direct'
        && chatData.memberIds.size() == 2
        && (
          isBlockedByUser(chatData.memberIds[0], actorUid)
          || isBlockedByUser(chatData.memberIds[1], actorUid)
        );
    }

    function isValidChatRoom(data, chatId) {
      return data.keys().hasAll([
          'chatId', 'type', 'memberIds', 'adminIds', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'chatId', 'type', 'directPairKey', 'title', 'description', 'photoURL',
          'groupCategory', 'memberIds', 'adminIds', 'createdBy',
          'pinnedMessageId', 'pinnedPreviewText',
          'lastMessageId', 'lastMessagePreview', 'lastMessageType',
          'lastMessageSenderUid', 'lastMessageSenderName', 'lastMessageAtMs',
          'lastMessageAt', 'createdAt', 'updatedAt'
        ])
        && data.chatId is string && data.chatId == chatId && isValidId(data.chatId)
        && data.type in ['direct', 'group']
        && data.memberIds is list && data.memberIds.size() >= 1 && data.memberIds.size() <= 150
        && data.adminIds is list && data.adminIds.size() >= 0 && data.adminIds.size() <= 150
        && data.createdBy is string && isValidId(data.createdBy)
        && (!('directPairKey' in data) || (data.directPairKey is string && data.directPairKey.size() <= 200))
        && (!('title' in data) || (data.title is string && data.title.size() <= 80))
        && (!('description' in data) || (data.description is string && data.description.size() <= 240))
        && (!('photoURL' in data) || isValidAvatarUrl(data.photoURL))
        && (!('groupCategory' in data) || data.groupCategory in ['turma', 'instrutores', 'administracao', 'comunicados', 'duvidas', 'aulas'])
        && (!('pinnedMessageId' in data) || (data.pinnedMessageId is string && data.pinnedMessageId.size() <= 128))
        && (!('pinnedPreviewText' in data) || (data.pinnedPreviewText is string && data.pinnedPreviewText.size() <= 160))
        && (!('lastMessageId' in data) || (data.lastMessageId is string && data.lastMessageId.size() <= 128))
        && (!('lastMessagePreview' in data) || (data.lastMessagePreview is string && data.lastMessagePreview.size() <= 160))
        && (!('lastMessageType' in data) || data.lastMessageType in ['text', 'image', 'video', 'audio', 'file'])
        && (!('lastMessageSenderUid' in data) || (data.lastMessageSenderUid is string && data.lastMessageSenderUid.size() <= 128))
        && (!('lastMessageSenderName' in data) || (data.lastMessageSenderName is string && data.lastMessageSenderName.size() <= 60))
        && (!('lastMessageAtMs' in data) || (data.lastMessageAtMs is int && data.lastMessageAtMs >= 0))
        && (!('lastMessageAt' in data) || data.lastMessageAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChatMember(data, chatId, uid) {
      return data.keys().hasAll([
          'uid', 'chatId', 'role', 'muted', 'pinned', 'unreadCount',
          'lastReadAtMs', 'lastDeliveredAtMs', 'typingAtMs', 'joinedAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'chatId', 'role', 'muted', 'pinned', 'unreadCount',
          'lastReadAtMs', 'lastDeliveredAtMs', 'typingAtMs', 'joinedAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == uid && isValidId(data.uid)
        && data.chatId is string && data.chatId == chatId && isValidId(data.chatId)
        && data.role in ['owner', 'admin', 'member']
        && data.muted is bool
        && data.pinned is bool
        && data.unreadCount is int && data.unreadCount >= 0 && data.unreadCount <= 100000
        && data.lastReadAtMs is int && data.lastReadAtMs >= 0
        && data.lastDeliveredAtMs is int && data.lastDeliveredAtMs >= 0
        && data.typingAtMs is int && data.typingAtMs >= 0
        && data.joinedAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChatMessage(data, chatId, messageId) {
      return data.keys().hasAll([
          'messageId', 'chatId', 'senderUid', 'senderName', 'type', 'text',
          'deletedForAll', 'deletedForUids', 'pinned', 'createdAtMs', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'messageId', 'chatId', 'senderUid', 'senderName', 'senderPhotoURL',
          'type', 'text', 'replyTo', 'forwardedFrom', 'reactions', 'attachment',
          'deliveredToUids', 'readByUids', 'editedAtMs',
          'deletedForAll', 'deletedForUids', 'pinned', 'clientNonce',
          'createdAtMs', 'createdAt', 'updatedAt'
        ])
        && data.messageId is string && data.messageId == messageId && isValidId(data.messageId)
        && data.chatId is string && data.chatId == chatId && isValidId(data.chatId)
        && data.senderUid is string && isValidId(data.senderUid)
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 60
        && (!('senderPhotoURL' in data) || isValidAvatarUrl(data.senderPhotoURL))
        && data.type in ['text', 'image', 'video', 'audio', 'file']
        && data.text is string && data.text.size() <= 4000
        && (!('replyTo' in data) || data.replyTo is map)
        && (!('forwardedFrom' in data) || data.forwardedFrom is map)
        && (!('reactions' in data) || data.reactions is map)
        && (!('attachment' in data) || (
          data.attachment is map
          && data.attachment.fileId is string && isValidId(data.attachment.fileId)
          && data.attachment.sizeBytes is int && data.attachment.sizeBytes >= 1 && data.attachment.sizeBytes <= 20971520
        ))
        && (!('deliveredToUids' in data) || (data.deliveredToUids is list && data.deliveredToUids.size() <= 200))
        && (!('readByUids' in data) || (data.readByUids is list && data.readByUids.size() <= 200))
        && (!('editedAtMs' in data) || (data.editedAtMs is int && data.editedAtMs >= 0))
        && data.deletedForAll is bool
        && data.deletedForUids is list && data.deletedForUids.size() <= 200
        && data.pinned is bool
        && (!('clientNonce' in data) || (data.clientNonce is string && data.clientNonce.size() <= 80))
        && data.createdAtMs is int && data.createdAtMs >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChatFileManifest(data, chatId, fileId) {
      return data.keys().hasAll([
          'fileId', 'chatId', 'senderUid', 'fileName', 'mimeType', 'extension',
          'sizeBytes', 'chunkCount', 'sha256', 'completed', 'createdAt'
        ])
        && data.keys().hasOnly([
          'fileId', 'chatId', 'senderUid', 'fileName', 'mimeType', 'extension',
          'sizeBytes', 'chunkCount', 'sha256', 'completed', 'createdAt'
        ])
        && data.fileId is string && data.fileId == fileId && isValidId(data.fileId)
        && data.chatId is string && data.chatId == chatId && isValidId(data.chatId)
        && data.senderUid is string && isValidId(data.senderUid)
        && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 180
        && data.mimeType is string && data.mimeType.size() >= 1 && data.mimeType.size() <= 120
        && data.extension is string && data.extension.size() >= 1 && data.extension.size() <= 16
        && data.sizeBytes is int && data.sizeBytes >= 1 && data.sizeBytes <= 20971520
        && data.chunkCount is int && data.chunkCount >= 1 && data.chunkCount <= 60
        && data.sha256 is string && data.sha256.size() >= 8 && data.sha256.size() <= 128
        && data.completed is bool
        && data.createdAt is timestamp;
    }

    function isValidChatFileChunk(data, chatId, chunkId) {
      return data.keys().hasAll(['chunkId', 'fileId', 'chatId', 'senderUid', 'chunkIndex', 'dataBase64', 'createdAt'])
        && data.keys().hasOnly(['chunkId', 'fileId', 'chatId', 'senderUid', 'chunkIndex', 'dataBase64', 'createdAt'])
        && data.chunkId is string && data.chunkId == chunkId && isValidLongId(data.chunkId)
        && data.fileId is string && isValidId(data.fileId)
        && data.chatId is string && data.chatId == chatId && isValidId(data.chatId)
        && data.senderUid is string && isValidId(data.senderUid)
        && data.chunkIndex is int && data.chunkIndex >= 0 && data.chunkIndex < 60
        && data.dataBase64 is string && data.dataBase64.size() <= 750000
        && data.createdAt is timestamp;
    }

    function isValidChatPresence(data, uid) {
      return data.keys().hasAll([
          'uid', 'online', 'lastSeenAtMs', 'hideOnline', 'hideLastSeen',
          'blockedUids', 'notificationsEnabled', 'groupNotificationsEnabled',
          'showPreviews', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'online', 'lastSeenAtMs', 'hideOnline', 'hideLastSeen',
          'blockedUids', 'notificationsEnabled', 'groupNotificationsEnabled',
          'showPreviews', 'updatedAt'
        ])
        && data.uid is string && data.uid == uid && isValidId(data.uid)
        && data.online is bool
        && data.lastSeenAtMs is int && data.lastSeenAtMs >= 0
        && data.hideOnline is bool
        && data.hideLastSeen is bool
        && data.blockedUids is list && data.blockedUids.size() <= 500
        && data.notificationsEnabled is bool
        && data.groupNotificationsEnabled is bool
        && data.showPreviews is bool
        && data.updatedAt is timestamp;
    }

    function isValidChatFavorite(data, uid, favId) {
      return data.keys().hasAll([
          'favoriteId', 'uid', 'chatId', 'chatTitle', 'messageId',
          'senderName', 'type', 'previewText', 'createdAtMs', 'savedAt'
        ])
        && data.keys().hasOnly([
          'favoriteId', 'uid', 'chatId', 'chatTitle', 'messageId',
          'senderName', 'type', 'previewText', 'attachmentName', 'createdAtMs', 'savedAt'
        ])
        && data.favoriteId is string && data.favoriteId == favId && isValidLongId(data.favoriteId)
        && data.uid is string && data.uid == uid && isValidId(data.uid)
        && data.chatId is string && isValidId(data.chatId)
        && data.chatTitle is string && data.chatTitle.size() >= 1 && data.chatTitle.size() <= 100
        && data.messageId is string && isValidId(data.messageId)
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 60
        && data.type in ['text', 'image', 'video', 'audio', 'file']
        && data.previewText is string && data.previewText.size() >= 1 && data.previewText.size() <= 260
        && (!('attachmentName' in data) || (data.attachmentName is string && data.attachmentName.size() <= 180))
        && data.createdAtMs is int && data.createdAtMs >= 0
        && data.savedAt is timestamp;
    }

    function isValidChatNotification(data, notifId) {
      return data.keys().hasAll([
          'notifId', 'recipientUid', 'chatId', 'type', 'senderUid',
          'senderName', 'title', 'body', 'read', 'createdAt'
        ])
        && data.keys().hasOnly([
          'notifId', 'recipientUid', 'chatId', 'messageId', 'type', 'senderUid',
          'senderName', 'title', 'body', 'read', 'createdAt'
        ])
        && data.notifId is string && data.notifId == notifId && isValidId(data.notifId)
        && data.recipientUid is string && isValidId(data.recipientUid)
        && data.chatId is string && isValidId(data.chatId)
        && (!('messageId' in data) || (data.messageId is string && isValidId(data.messageId)))
        && data.type in ['message', 'reply', 'mention', 'file', 'group_join', 'pinned']
        && data.senderUid is string && isValidId(data.senderUid)
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 60
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 100
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 260
        && data.read is bool
        && data.createdAt is timestamp;
    }

    function isValidChatReport(data, reportId) {
      return data.keys().hasAll([
          'reportId', 'reporterUid', 'chatId', 'messageId', 'reportedUid',
          'reason', 'status', 'createdAt'
        ])
        && data.keys().hasOnly([
          'reportId', 'reporterUid', 'chatId', 'messageId', 'reportedUid',
          'fileId', 'reason', 'details', 'status', 'createdAt'
        ])
        && data.reportId is string && data.reportId == reportId && isValidId(data.reportId)
        && data.reporterUid is string && data.reporterUid == request.auth.uid && isValidId(data.reporterUid)
        && data.chatId is string && isValidId(data.chatId)
        && data.messageId is string && isValidId(data.messageId)
        && data.reportedUid is string && isValidId(data.reportedUid)
        && (!('fileId' in data) || (data.fileId is string && isValidId(data.fileId)))
        && data.reason is string && data.reason.size() >= 2 && data.reason.size() <= 120
        && (!('details' in data) || (data.details is string && data.details.size() <= 500))
        && data.status in ['pending', 'reviewed']
        && data.createdAt is timestamp;
    }

    // =========================================================================
    // Collections
    // =========================================================================
    match /admins/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list: if isSignedIn() && isBootstrappedAdmin();
      allow create: if isSignedIn() && isValidId(uid) && isAdmin() && isValidAdminMarker(incoming(), uid) && incoming().grantedAt == request.time;
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow get: if isSignedIn() && isValidId(uid);
      allow list: if isSignedIn() && (resource.data.disabled == false || canViewReservedScreens());
      allow create: if isSignedIn() && isValidId(uid) && isOwner(uid)
        && isValidUserProfile(incoming(), uid)
        && incoming().totalPoints == 0
        && incoming().wins == 0
        && incoming().gamesPlayed == 0
        && incoming().correctAnswers == 0
        && incoming().totalAnswers == 0
        && incoming().currentStreak == 0
        && incoming().bestStreak == 0
        && incoming().tier == 'Aprendiz'
        && incoming().disabled == false
        && (!('lastActiveAt' in incoming()) || incoming().lastActiveAt == request.time)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(uid) && isValidUserProfile(incoming(), uid)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            isOwner(uid) && existing().disabled == false && incoming().disabled == false
            && incoming().lastActiveAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['lastActiveAt', 'updatedAt'])
          )
          || (
            isOwner(uid) && existing().disabled == false && incoming().disabled == false
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])
          )
          || (
            isOwner(uid) && existing().disabled == false && incoming().disabled == false
            && incoming().totalPoints >= existing().totalPoints
            && incoming().totalPoints <= existing().totalPoints + 100
            && incoming().correctAnswers >= existing().correctAnswers
            && incoming().correctAnswers <= existing().correctAnswers + 1
            && incoming().totalAnswers == existing().totalAnswers + 1
            && incoming().gamesPlayed == existing().gamesPlayed
            && incoming().wins == existing().wins
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'totalPoints', 'correctAnswers', 'totalAnswers', 'tier', 'updatedAt'
            ])
          )
          || (
            isOwner(uid) && existing().disabled == false && incoming().disabled == false
            && incoming().totalPoints >= existing().totalPoints
            && incoming().totalPoints <= existing().totalPoints + 500
            && incoming().gamesPlayed == existing().gamesPlayed + 1
            && incoming().wins >= existing().wins && incoming().wins <= existing().wins + 1
            && incoming().correctAnswers >= existing().correctAnswers
            && incoming().totalAnswers >= existing().totalAnswers
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'totalPoints', 'wins', 'gamesPlayed', 'correctAnswers', 'totalAnswers',
              'currentStreak', 'bestStreak', 'tier', 'updatedAt'
            ])
          )
          || (
            isOwner(uid) && existing().disabled == false && incoming().disabled == false
            && incoming().totalPoints == 0
            && incoming().wins == 0
            && incoming().gamesPlayed == 0
            && incoming().correctAnswers == 0
            && incoming().totalAnswers == 0
            && incoming().currentStreak == 0
            && incoming().bestStreak == 0
            && incoming().tier == 'Aprendiz'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'totalPoints', 'wins', 'gamesPlayed', 'correctAnswers', 'totalAnswers',
              'currentStreak', 'bestStreak', 'tier', 'updatedAt'
            ])
          )
        );
      allow delete: if isSignedIn() && isValidId(uid) && (isOwner(uid) || isAdmin());

      // Strictly isolated PII subcollection
      match /private/info {
        allow get: if isSignedIn() && isValidId(uid) && (isOwner(uid) || isAdmin());
        allow list: if false;
        allow create: if isSignedIn() && isValidId(uid) && isOwner(uid)
          && isValidUserPrivateInfo(incoming(), uid)
          && incoming().updatedAt == request.time;
        allow update: if isSignedIn() && isValidId(uid) && isOwner(uid)
          && isValidUserPrivateInfo(incoming(), uid)
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'email', 'drivingSchool', 'province', 'voiceEnabled',
            'notificationsEnabled', 'broadcastsReadAtMs', 'notificationsClearedBeforeMs',
            'totpEnabled', 'totpSealedSecret', 'updatedAt'
          ]);
        allow delete: if isSignedIn() && isValidId(uid) && (isOwner(uid) || isAdmin());
      }

      match /chat_favorites/{favId} {
        allow get: if isSignedIn() && isValidId(uid) && isValidLongId(favId) && isOwner(uid);
        allow list: if isSignedIn() && isValidId(uid) && isOwner(uid);
        allow create: if isSignedIn() && isValidId(uid) && isValidLongId(favId)
          && isOwner(uid)
          && isValidChatFavorite(incoming(), uid, favId)
          && incoming().savedAt == request.time;
        allow update: if false;
        allow delete: if isSignedIn() && isValidId(uid) && isValidLongId(favId) && (isOwner(uid) || isAdmin());
      }
    }

    match /rooms/{roomId} {
      allow get: if isSignedIn() && isValidId(roomId);
      allow list: if isSignedIn() && (
        resource.data.isPublic == true
        || resource.data.hostId == request.auth.uid
        || canViewReservedScreens()
      );
      allow create: if isSignedIn() && isValidId(roomId)
        && isUserNotDisabled(request.auth.uid)
        && isValidRoom(incoming(), roomId)
        && incoming().hostId == request.auth.uid
        && incoming().status == 'WAITING'
        && incoming().participantCount == 0
        && (!('finishedCount' in incoming()) || incoming().finishedCount == 0)
        && incoming().currentQuestionIndex == -1
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(roomId)
        && isUserNotDisabled(request.auth.uid)
        && isValidRoom(incoming(), roomId)
        && incoming().roomId == existing().roomId
        && incoming().hostId == existing().hostId
        && incoming().code == existing().code
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            existing().status != 'FINISHED'
            && (!('finishedCount' in existing()) || existing().finishedCount < 100)
            && (incoming().participantCount == existing().participantCount + 1 || incoming().participantCount == existing().participantCount - 1)
            && incoming().participantCount >= 0
            && incoming().participantCount <= existing().maxParticipants
            && incoming().diff(existing()).affectedKeys().hasOnly(['participantCount', 'updatedAt'])
          )
          || (
            existing().status == 'WAITING'
            && (!('finishedCount' in existing()) || existing().finishedCount < 100)
            && incoming().status == 'PLAYING'
            && exists(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid))
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
          || (
            existing().status != 'FINISHED'
            && (!('finishedCount' in existing()) || existing().finishedCount < 100)
            && incoming().finishedCount == (('finishedCount' in existing() ? existing().finishedCount : 0) + 1)
            && incoming().finishedCount <= 100
            && (
              incoming().finishedCount >= 100
                ? incoming().status == 'FINISHED'
                : incoming().status == existing().status
            )
            && exists(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid))
            && get(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid)).data.status != 'FINISHED'
            && getAfter(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid)).data.status == 'FINISHED'
            && incoming().diff(existing()).affectedKeys().hasOnly(['finishedCount', 'status', 'updatedAt'])
          )
        );
      allow delete: if isSignedIn() && isValidId(roomId) && (existing().hostId == request.auth.uid || isAdmin());

      match /participants/{uid} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidId(uid);
        allow list: if isSignedIn() && resource.data.roomId == roomId;
        allow create: if isSignedIn() && isValidId(roomId) && isValidId(uid)
          && isOwner(uid)
          && isUserNotDisabled(uid)
          && isValidParticipant(incoming(), roomId, uid)
          && incoming().score == 0
          && incoming().correctCount == 0
          && incoming().wrongCount == 0
          && incoming().lastScoredQuestionIndex == -1
          && incoming().status == 'WAITING'
          && incoming().currentQuestionIndex == -1
          && incoming().questionsGenerated == false
          && incoming().joinedAt == request.time
          && incoming().lastActiveAt == request.time
          && exists(/databases/$(database)/documents/rooms/$(roomId))
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.status != 'FINISHED'
          && (
            !('finishedCount' in get(/databases/$(database)/documents/rooms/$(roomId)).data)
            || get(/databases/$(database)/documents/rooms/$(roomId)).data.finishedCount < 100
          );
        allow update: if isSignedIn() && isValidId(roomId) && isValidId(uid)
          && isValidParticipant(incoming(), roomId, uid)
          && incoming().uid == existing().uid
          && incoming().roomId == existing().roomId
          && incoming().joinedAt == existing().joinedAt
          && incoming().lastActiveAt == request.time
          && (
            isAdmin()
            || (
              isOwner(uid)
              && existing().status != 'FINISHED'
              && get(/databases/$(database)/documents/rooms/$(roomId)).data.status != 'FINISHED'
              && (
                !('finishedCount' in get(/databases/$(database)/documents/rooms/$(roomId)).data)
                || get(/databases/$(database)/documents/rooms/$(roomId)).data.finishedCount < 100
              )
              && (
                incoming().diff(existing()).affectedKeys().hasOnly(['online', 'lastActiveAt'])
                || (
                  incoming().status == 'PLAYING'
                  && incoming().questionsGenerated == true
                  && incoming().currentQuestionIndex >= 0
                  && incoming().currentQuestionIndex < get(/databases/$(database)/documents/rooms/$(roomId)).data.totalQuestions
                  && (
                    (existing().status == 'WAITING' && incoming().currentQuestionIndex == 0)
                    || (
                      existing().status == 'ANSWER_REVEAL'
                      && incoming().currentQuestionIndex == existing().currentQuestionIndex + 1
                      && existing().lastScoredQuestionIndex == existing().currentQuestionIndex
                    )
                  )
                  && ('questionEndsAt' in incoming())
                  && incoming().diff(existing()).affectedKeys().hasOnly([
                    'status', 'currentQuestionIndex', 'questionsGenerated',
                    'questionStartedAtMs', 'questionEndsAtMs', 'questionEndsAt',
                    'roundToken', 'lastActiveAt'
                  ])
                )
                || (
                  isValidPlayerScoreStep(roomId, uid, incoming(), existing())
                  && incoming().diff(existing()).affectedKeys().hasOnly([
                    'status', 'score', 'correctCount', 'wrongCount',
                    'lastScoredQuestionIndex', 'lastActiveAt'
                  ])
                )
                || (
                  existing().status == 'ANSWER_REVEAL'
                  && existing().lastScoredQuestionIndex == get(/databases/$(database)/documents/rooms/$(roomId)).data.totalQuestions - 1
                  && incoming().status == 'FINISHED'
                  && ('finishedAt' in incoming())
                  && incoming().finishedAt == request.time
                  && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.finishedCount
                    == (('finishedCount' in get(/databases/$(database)/documents/rooms/$(roomId)).data
                      ? get(/databases/$(database)/documents/rooms/$(roomId)).data.finishedCount
                      : 0) + 1)
                  && incoming().diff(existing()).affectedKeys().hasOnly([
                    'status', 'finishedAt', 'lastActiveAt'
                  ])
                )
              )
            )
          );
        allow delete: if isSignedIn() && isValidId(roomId) && isValidId(uid) && (isOwner(uid) || isAdmin());
      }

      match /questions/{qIndex} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidId(qIndex);
        allow list: if isSignedIn() && resource.data.roomId == roomId;
        allow create: if false;
        allow update, delete: if false;
      }

      match /player_questions/{qDocId} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidLongId(qDocId)
          && (existing().uid == request.auth.uid || isAdmin());
        allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
        allow create: if isSignedIn() && isValidId(roomId) && isValidLongId(qDocId)
          && isValidRoomQuestion(incoming(), roomId)
          && ('uid' in incoming())
          && incoming().uid == request.auth.uid
          && qDocId == (request.auth.uid + '_' + string(incoming().questionIndex))
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid))
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.status != 'FINISHED'
          && (
            !('finishedCount' in get(/databases/$(database)/documents/rooms/$(roomId)).data)
            || get(/databases/$(database)/documents/rooms/$(roomId)).data.finishedCount < 100
          );
        allow update, delete: if false;
      }

      match /answers/{answerId} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidLongId(answerId);
        allow list: if isSignedIn() && resource.data.roomId == roomId;
        allow create: if isSignedIn() && isValidId(roomId) && isValidLongId(answerId)
          && isUserNotDisabled(request.auth.uid)
          && isValidRoomAnswer(incoming(), roomId)
          && incoming().submittedAt == request.time
          && answerId == (string(incoming().questionIndex) + '_' + request.auth.uid)
          && exists(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid))
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.status != 'FINISHED'
          && (
            !('finishedCount' in get(/databases/$(database)/documents/rooms/$(roomId)).data)
            || get(/databases/$(database)/documents/rooms/$(roomId)).data.finishedCount < 100
          )
          && get(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid)).data.status == 'PLAYING'
          && get(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid)).data.currentQuestionIndex == incoming().questionIndex
          && ('questionEndsAt' in get(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid)).data)
          && request.time <= get(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid)).data.questionEndsAt;
        allow update, delete: if false;
      }

      match /revealed/{qIndex} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidId(qIndex);
        allow list: if isSignedIn() && resource.data.roomId == roomId;
        allow create: if false;
        allow update, delete: if false;
      }

      match /player_revealed/{rDocId} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidLongId(rDocId)
          && (existing().uid == request.auth.uid || isAdmin());
        allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
        allow create: if isSignedIn() && isValidId(roomId) && isValidLongId(rDocId)
          && isValidRevealedAnswer(incoming(), roomId)
          && ('uid' in incoming())
          && incoming().uid == request.auth.uid
          && rDocId == (request.auth.uid + '_' + string(incoming().questionIndex))
          && incoming().revealedAt == request.time
          && exists(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid))
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.status != 'FINISHED'
          && (
            !('finishedCount' in get(/databases/$(database)/documents/rooms/$(roomId)).data)
            || get(/databases/$(database)/documents/rooms/$(roomId)).data.finishedCount < 100
          );
        allow update, delete: if false;
      }
    }

    match /competitions/{competitionId} {
      allow get: if isSignedIn() && isValidId(competitionId);
      allow list: if isSignedIn() && (resource.data.isPublic == true || canViewReservedScreens());
      allow create: if isSignedIn() && isValidId(competitionId)
        && isValidCompetitionArchive(incoming(), competitionId)
        && incoming().finishedAt == request.time
        && exists(/databases/$(database)/documents/rooms/$(incoming().roomId))
        && (
          get(/databases/$(database)/documents/rooms/$(incoming().roomId)).data.hostId == request.auth.uid
          || get(/databases/$(database)/documents/rooms/$(incoming().roomId)).data.status == 'FINISHED'
          || isAdmin()
        );
      allow update, delete: if false;
    }

    match /results/{resultId} {
      allow get: if isSignedIn() && isValidLongId(resultId) && (existing().uid == request.auth.uid || existing().isPublic == true || canViewReservedScreens());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || resource.data.isPublic == true || canViewReservedScreens());
      allow create: if isSignedIn() && isValidLongId(resultId)
        && isValidUserResult(incoming(), resultId)
        && resultId == (incoming().roomId + '_' + request.auth.uid)
        && incoming().finishedAt == request.time
        && exists(/databases/$(database)/documents/rooms/$(incoming().roomId)/participants/$(request.auth.uid))
        && get(/databases/$(database)/documents/rooms/$(incoming().roomId)/participants/$(request.auth.uid)).data.status == 'FINISHED';
      allow update: if false;
      allow delete: if isSignedIn() && isValidLongId(resultId) && (existing().uid == request.auth.uid || isAdmin());
    }

    match /global_rankings/{uid} {
      allow get: if isSignedIn() && isValidId(uid);
      allow list: if isSignedIn() && resource.data.points >= 0;
      allow create: if isSignedIn() && isValidId(uid) && isOwner(uid)
        && isValidRankingEntry(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(uid)
        && isValidRankingEntry(incoming())
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            isOwner(uid)
            && incoming().points == existing().points
            && incoming().wins == existing().wins
            && incoming().gamesPlayed == existing().gamesPlayed
            && incoming().accuracy == existing().accuracy
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'photoURL', 'updatedAt'
            ])
          )
          || (
            isOwner(uid)
            && incoming().points >= existing().points
            && incoming().points <= existing().points + 500
            && incoming().gamesPlayed == existing().gamesPlayed + 1
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'photoURL', 'points', 'wins', 'gamesPlayed', 'accuracy', 'updatedAt'
            ])
          )
        );
      allow delete: if isSignedIn() && isValidId(uid) && (isOwner(uid) || isAdmin());
    }

    match /weekly_rankings/{entryId} {
      allow get: if isSignedIn() && isValidLongId(entryId);
      allow list: if isSignedIn() && resource.data.points >= 0;
      allow create: if isSignedIn() && isValidLongId(entryId)
        && isValidRankingEntry(incoming())
        && ('weekKey' in incoming())
        && entryId == (incoming().weekKey + '_' + request.auth.uid)
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidLongId(entryId)
        && isValidRankingEntry(incoming())
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            existing().uid == request.auth.uid
            && incoming().points == existing().points
            && incoming().wins == existing().wins
            && incoming().gamesPlayed == existing().gamesPlayed
            && incoming().accuracy == existing().accuracy
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'photoURL', 'updatedAt'
            ])
          )
          || (
            existing().uid == request.auth.uid
            && incoming().points >= existing().points
            && incoming().points <= existing().points + 500
            && incoming().gamesPlayed == existing().gamesPlayed + 1
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'photoURL', 'points', 'wins', 'gamesPlayed', 'accuracy', 'updatedAt'
            ])
          )
        );
      allow delete: if isSignedIn() && isValidLongId(entryId) && (existing().uid == request.auth.uid || isAdmin());
    }

    match /achievements/{entryId} {
      allow get: if isSignedIn() && isValidLongId(entryId);
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || resource.data.tier in ['bronze', 'silver', 'gold']);
      allow create: if isSignedIn() && isValidLongId(entryId)
        && isValidAchievement(incoming())
        && entryId == (request.auth.uid + '_' + incoming().achievementId)
        && incoming().unlockedAt == request.time;
      allow update: if false;
      allow delete: if isSignedIn() && isValidLongId(entryId) && (existing().uid == request.auth.uid || isAdmin());
    }

    match /notifications/{notificationId} {
      allow get: if isSignedIn() && isValidId(notificationId) && (existing().uid == request.auth.uid || isBootstrappedAdmin());
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && isValidId(notificationId)
        && isValidNotification(incoming())
        && (incoming().uid == request.auth.uid || isBootstrappedAdmin())
        && incoming().createdAt == request.time;
      allow update: if isSignedIn() && isValidId(notificationId)
        && isValidNotification(incoming())
        && existing().uid == request.auth.uid
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && isValidId(notificationId) && (existing().uid == request.auth.uid || isBootstrappedAdmin());
    }

    match /broadcasts/{broadcastId} {
      allow get: if isSignedIn() && isValidId(broadcastId) && (existing().active == true || canAnnounce() || canViewReservedScreens());
      allow list: if isSignedIn() && (resource.data.active == true || canAnnounce() || canViewReservedScreens());
      allow create: if isSignedIn() && isValidId(broadcastId) && canAnnounce()
        && isValidBroadcast(incoming(), broadcastId)
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(broadcastId) && canAnnounce()
        && isValidBroadcast(incoming(), broadcastId)
        && incoming().id == existing().id
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isSignedIn() && isValidId(broadcastId) && canAnnounce();
    }

    match /question_bank/{questionId} {
      allow get: if isSignedIn() && isValidId(questionId) && (existing().active == true || canViewReservedScreens());
      allow list: if isSignedIn() && (resource.data.active == true || canViewReservedScreens());
      allow create: if isSignedIn() && isValidId(questionId) && isAdmin()
        && isValidQuestionBankItem(incoming())
        && incoming().createdAt == request.time;
      allow update: if isSignedIn() && isValidId(questionId) && isAdmin()
        && isValidQuestionBankItem(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'questionText', 'options', 'correctIndex', 'explanation', 'legalReference',
          'category', 'difficulty', 'signType', 'active'
        ]);
      allow delete: if isSignedIn() && isValidId(questionId) && isAdmin();
    }

    match /audit_logs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && canViewReservedScreens();
      allow list: if isSignedIn() && canViewReservedScreens();
      allow create: if isSignedIn() && isValidId(logId) && (isAdmin() || canAnnounce())
        && isValidAuditLog(incoming())
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /staff_permissions/{emailKey} {
      allow get: if isSignedIn() && isValidEmailKey(emailKey)
        && (isBootstrappedAdmin() || (isCallerEmailVerified() && request.auth.token.email.lower() == emailKey));
      allow list: if isSignedIn() && isBootstrappedAdmin();
      allow create: if isSignedIn() && isValidEmailKey(emailKey) && isBootstrappedAdmin()
        && isValidStaffPermission(incoming(), emailKey)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidEmailKey(emailKey) && isBootstrappedAdmin()
        && isValidStaffPermission(incoming(), emailKey)
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isSignedIn() && isValidEmailKey(emailKey) && isBootstrappedAdmin();
    }

    match /platform_stats/{statId} {
      allow get: if isSignedIn() && statId == 'users_summary';
      allow list: if false;
      allow create: if isSignedIn() && statId == 'users_summary'
        && isValidPlatformUsersStats(incoming())
        && incoming().updatedAt == request.time
        && incoming().deletedCount == 1
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isSignedIn() && statId == 'users_summary'
        && isValidPlatformUsersStats(incoming())
        && incoming().updatedAt == request.time
        && incoming().deletedCount == existing().deletedCount + 1
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
        && incoming().diff(existing()).affectedKeys().hasOnly(['deletedCount', 'updatedAt']);
      allow delete: if false;
    }

    // =========================================================================
    // LIVE CHAT Collections (Participant-Scoped Fortress Rules)
    // =========================================================================
    match /chats/{chatId} {
      allow get: if isSignedIn() && isValidId(chatId)
        && (request.auth.uid in existing().memberIds || isAdmin());
      allow list: if isSignedIn() && (request.auth.uid in resource.data.memberIds);
      allow create: if isSignedIn() && isValidId(chatId)
        && isUserNotDisabled(request.auth.uid)
        && isValidChatRoom(incoming(), chatId)
        && incoming().createdBy == request.auth.uid
        && request.auth.uid in incoming().memberIds
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(chatId)
        && request.auth.uid in existing().memberIds
        && isValidChatRoom(incoming(), chatId)
        && incoming().chatId == existing().chatId
        && incoming().type == existing().type
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          request.auth.uid in existing().adminIds
          || isAdmin()
          || (
            !isDirectChatBlocked(existing(), request.auth.uid)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'lastMessageId', 'lastMessagePreview', 'lastMessageType',
              'lastMessageSenderUid', 'lastMessageSenderName',
              'lastMessageAtMs', 'lastMessageAt',
              'pinnedMessageId', 'pinnedPreviewText', 'updatedAt'
            ])
          )
          || (
            existing().type == 'group'
            && !(request.auth.uid in incoming().memberIds)
            && !(request.auth.uid in incoming().adminIds)
            && incoming().memberIds.size() == existing().memberIds.size() - 1
            && incoming().diff(existing()).affectedKeys().hasOnly(['memberIds', 'adminIds', 'updatedAt'])
          )
        );
      allow delete: if isSignedIn() && isValidId(chatId) && isAdmin();

      match /members/{uid} {
        allow get: if isSignedIn() && isValidId(uid) && isChatMember(chatId);
        allow list: if isSignedIn() && isChatMember(chatId);
        allow create: if isSignedIn() && isValidId(uid)
          && isValidChatMember(incoming(), chatId, uid)
          && incoming().joinedAt == request.time
          && incoming().updatedAt == request.time
          && (
            isOwner(uid)
            || isChatAdmin(chatId)
            || get(/databases/$(database)/documents/chats/$(chatId)).data.createdBy == request.auth.uid
          );
        allow update: if isSignedIn() && isValidId(uid)
          && isChatMember(chatId)
          && isValidChatMember(incoming(), chatId, uid)
          && incoming().uid == existing().uid
          && incoming().chatId == existing().chatId
          && incoming().joinedAt == existing().joinedAt
          && incoming().updatedAt == request.time
          && (
            isChatAdmin(chatId)
            || (
              isOwner(uid)
              && incoming().role == existing().role
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'muted', 'pinned', 'unreadCount', 'lastReadAtMs',
                'lastDeliveredAtMs', 'typingAtMs', 'updatedAt'
              ])
            )
          );
        allow delete: if isSignedIn() && isValidId(uid)
          && (isOwner(uid) || isChatAdmin(chatId) || isAdmin());
      }

      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(messageId) && isChatMember(chatId);
        allow list: if isSignedIn() && isChatMember(chatId);
        allow create: if isSignedIn() && isValidId(messageId)
          && isChatMember(chatId)
          && !isDirectChatBlocked(get(/databases/$(database)/documents/chats/$(chatId)).data, request.auth.uid)
          && isValidChatMessage(incoming(), chatId, messageId)
          && incoming().senderUid == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isSignedIn() && isValidId(messageId)
          && isChatMember(chatId)
          && isValidChatMessage(incoming(), chatId, messageId)
          && incoming().messageId == existing().messageId
          && incoming().chatId == existing().chatId
          && incoming().senderUid == existing().senderUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (
              existing().senderUid == request.auth.uid
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'text', 'editedAtMs', 'deletedForAll', 'deletedForUids', 'pinned', 'updatedAt'
              ])
            )
            || (
              isChatAdmin(chatId)
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'text', 'deletedForAll', 'deletedForUids', 'pinned', 'updatedAt'
              ])
            )
            || incoming().diff(existing()).affectedKeys().hasOnly([
              'reactions', 'deliveredToUids', 'readByUids', 'deletedForUids', 'pinned', 'updatedAt'
            ])
          );
        allow delete: if isSignedIn() && isValidId(messageId) && isAdmin();
      }

      match /file_manifests/{fileId} {
        allow get: if isSignedIn() && isValidId(fileId) && isChatMember(chatId);
        allow list: if isSignedIn() && isChatMember(chatId);
        allow create: if isSignedIn() && isValidId(fileId)
          && isChatMember(chatId)
          && isValidChatFileManifest(incoming(), chatId, fileId)
          && incoming().senderUid == request.auth.uid
          && incoming().createdAt == request.time;
        allow update: if isSignedIn() && isValidId(fileId)
          && isChatMember(chatId)
          && existing().senderUid == request.auth.uid
          && incoming().diff(existing()).affectedKeys().hasOnly(['completed']);
        allow delete: if isSignedIn() && isValidId(fileId)
          && (existing().senderUid == request.auth.uid || isAdmin());
      }

      match /file_chunks/{chunkId} {
        allow get: if isSignedIn() && isValidLongId(chunkId) && isChatMember(chatId);
        allow list: if isSignedIn() && isChatMember(chatId);
        allow create: if isSignedIn() && isValidLongId(chunkId)
          && isChatMember(chatId)
          && isValidChatFileChunk(incoming(), chatId, chunkId)
          && incoming().senderUid == request.auth.uid
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isSignedIn() && isValidLongId(chunkId)
          && (existing().senderUid == request.auth.uid || isAdmin());
      }
    }

    match /chat_presence/{uid} {
      allow get: if isSignedIn() && isValidId(uid);
      allow list: if isSignedIn() && resource.data.uid is string;
      allow create: if isSignedIn() && isValidId(uid)
        && isOwner(uid)
        && isValidChatPresence(incoming(), uid)
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(uid)
        && isOwner(uid)
        && isValidChatPresence(incoming(), uid)
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time;
      allow delete: if isSignedIn() && isValidId(uid) && (isOwner(uid) || isAdmin());
    }

    match /chat_notifications/{notifId} {
      allow get: if isSignedIn() && isValidId(notifId)
        && (existing().recipientUid == request.auth.uid || existing().senderUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.recipientUid == request.auth.uid;
      allow create: if isSignedIn() && isValidId(notifId)
        && isValidChatNotification(incoming(), notifId)
        && incoming().senderUid == request.auth.uid
        && isChatMember(incoming().chatId)
        && incoming().createdAt == request.time;
      allow update: if isSignedIn() && isValidId(notifId)
        && existing().recipientUid == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && isValidId(notifId)
        && (existing().recipientUid == request.auth.uid || isAdmin());
    }

    match /chat_reports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId)
        && (existing().reporterUid == request.auth.uid || canViewReservedScreens());
      allow list: if isSignedIn()
        && (resource.data.reporterUid == request.auth.uid || canViewReservedScreens());
      allow create: if isSignedIn() && isValidId(reportId)
        && isValidChatReport(incoming(), reportId)
        && isChatMember(incoming().chatId)
        && incoming().createdAt == request.time;
      allow update: if isSignedIn() && isValidId(reportId) && isAdmin();
      allow delete: if false;
    }
  }
}
