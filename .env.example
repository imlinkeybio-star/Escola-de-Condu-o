# GPT_API_KEY: Required server-side secret for OpenAI live competition question generation.
GPT_API_KEY="MY_GPT_API_KEY"

# GPT_MODEL: Configurable OpenAI model used for live competition question generation.
GPT_MODEL="gpt-4o-mini"

# GEMINI_API_KEY: Required for Gemini AI TTS voice synthesis, virtual examiner, and admin helpers.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SERVER_SIGNING_SECRET: Optional 32+ byte secret for HMAC round tokens and AES-256-GCM answer sealing.
SERVER_SIGNING_SECRET=

# GOOGLE_CLOUD_TTS_API_KEY: Optional Google Cloud Text-to-Speech API key (falls back to Gemini TTS when unset).
GOOGLE_CLOUD_TTS_API_KEY=
