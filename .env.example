# GEMINI_API_KEY: Required for Gemini AI API calls and Gemini TTS voice synthesis.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SERVER_SIGNING_SECRET: Optional 32+ byte secret for HMAC round tokens and AES-256-GCM answer sealing.
SERVER_SIGNING_SECRET=

# GOOGLE_CLOUD_TTS_API_KEY: Optional Google Cloud Text-to-Speech API key (falls back to Gemini TTS when unset).
GOOGLE_CLOUD_TTS_API_KEY=
